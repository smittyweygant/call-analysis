{
  "_comment": "WhisperX Recorder Default Configuration",
  "_docs": "Copy this file to config.default.json and fill in your values. User overrides go in ~/.config/whisperx/settings.json",
  "_secrets_docs": "Any secret-shaped value (obs_ws_password, hf_token, api_key) may be a literal string, an op://vault/item/field reference (resolved via the 1Password CLI at the point of use; requires op installed and signed in), or a keychain://service reference (resolved from the macOS login keychain, account = current user; add with `security add-generic-password -a $(whoami) -s '<service>' -w '<value>'`).",

  "recording": {
    "output_dir": "~/OBSRecordings",
    "obs_ws_port": "4455",
    "obs_ws_password": "YOUR_OBS_WEBSOCKET_PASSWORD",
    "keep_video": false
  },

  "transcription": {
    "diarize": false,
    "language": "en",
    "device": "cpu",
    "compute_type": "float32",
    "whisperx_path": "~/path/to/call-analysis/processing-pipeline/.venv/bin/whisperx",
    "hf_token": "YOUR_HUGGINGFACE_TOKEN"
  },
  
  "gdrive": {
    "_comment": "Google Drive integration - uploads analysis to Shared Drive as Google Docs",
    "enabled": false,
    "service_account_file": "YOUR_SERVICE_ACCOUNT_FILE.json",
    "parent_folder_id": "YOUR_DRIVE_FOLDER_ID",
    "_docs": "Folders are auto-created per call_type name under parent_folder_id. This can be a regular Drive folder with the service account granted Editor access, or a Shared Drive ID (Google Workspace only)."
  },
  
  "llm": {
    "_comment": "LLM provider for analysis. Supports 'openai' or 'anthropic'",
    "provider": "openai",
    "enabled": true,
    "_auto_analyze_docs": "If false, analysis doesn't run automatically after start/stop or process - use the 'analyze' command on demand instead. The transcript is the default deliverable.",
    "auto_analyze": false,

    "api_key": "YOUR_OPENAI_API_KEY",
    "model": "gpt-4o",

    "_anthropic_docs": "For Anthropic, set provider to 'anthropic'",
    "anthropic_api_key": "YOUR_ANTHROPIC_API_KEY",
    "anthropic_model": "claude-sonnet-5"
  },
  
  "_call_types_docs": "Define custom call types below. Each type can have: name, icon, prompt (or prompt_template for dynamic prompts), requires_person_name (for 1:1s), and context_files (array of paths relative to context_base_path in user settings, or repo root if not set)",
  
  "call_types": {
    "team_meeting": {
      "name": "Team Meeting",
      "icon": "👥",
      "prompt": "You are analyzing a team meeting transcript. Please provide:\n1. **Meeting Summary** - A concise overview of what was discussed\n2. **Key Decisions** - Any decisions that were made\n3. **Action Items** - Tasks assigned with owners if mentioned\n4. **Follow-ups** - Items that need future attention\n\nBe specific and actionable in your analysis."
    },
    "interview": {
      "_comment": "Example showing context_files usage. Files load from context_base_path (user settings) or examples/ folder",
      "name": "Interview",
      "icon": "👔",
      "context_files": [
        "examples/context/interview_shared_context.md",
        "examples/context/interview_rubric.md"
      ],
      "prompt": "You are analyzing an interview transcript. Using the provided context about our hiring criteria and evaluation rubric, please provide:\n1. **Overall Assessment** - Your recommendation (Inclined/Not Inclined) with rationale\n2. **Strengths** - Key positive signals observed\n3. **Areas of Concern** - Any gaps or red flags\n4. **Role Fit** - Assessment of candidate fit for the role\n5. **Follow-up Questions** - Suggested topics for next round\n\nBe direct and specific in your evaluation."
    },
    "one_on_one": {
      "name": "1:1",
      "icon": "👤",
      "prompt_template": "You are analyzing a 1:1 meeting transcript with {person_name}. Please provide:\n1. **Discussion Topics** - Main subjects covered\n2. **Employee Concerns** - Any issues or blockers raised\n3. **Career Development** - Growth discussions or goals mentioned\n4. **Action Items** - Follow-ups for both manager and employee\n5. **Sentiment** - Overall tone and engagement level\n6. **Notes for Next 1:1** - Topics to revisit",
      "requires_person_name": true
    },
    "customer_meeting": {
      "_comment": "Customer meetings prompt for company name. prompt_file loads from external markdown.",
      "name": "Customer Meeting",
      "icon": "🤝",
      "context_files": [
        "Agent_context/customer_meeting_context.md"
      ],
      "prompt_file": "Agent_prompts/customer_meeting_evaluation_prompt.md",
      "requires_person_name": true,
      "name_prompt": "Enter customer/company name"
    },
    "project": {
      "name": "Project Meeting",
      "icon": "🚀",
      "prompt": "You are analyzing a Project/Initiative meeting transcript. Please provide:\n1. **Project Status** - Current phase and overall health\n2. **Progress Update** - Milestones achieved since last meeting\n3. **Blockers** - Issues impeding progress\n4. **Risks** - Potential problems and mitigation plans\n5. **Resource Needs** - People, budget, or tool requirements\n6. **Next Steps** - Immediate priorities and timeline\n7. **Action Items** - Tasks with owners and due dates"
    },
    "generic": {
      "name": "Recording",
      "icon": "🎙️",
      "prompt": "You are analyzing a meeting/call transcript. Please provide:\n1. **Summary** - Brief overview of the discussion\n2. **Key Points** - Main topics covered\n3. **Decisions Made** - Any conclusions reached\n4. **Action Items** - Follow-ups with owners if mentioned\n5. **Notable Quotes** - Important statements worth highlighting"
    }
  }
}
